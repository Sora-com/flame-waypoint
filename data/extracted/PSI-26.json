    "paper_findings": [
      {
        "text": "Flame spread rate was fastest at an intermediate value of flow speed in opposed flow.",
        "source": "ntrs:20140011099"
      },
      {
        "text": "Flame spread rate increased linearly with increasing flow in concurrent flow.",
        "source": "ntrs:20140011099"
      },
      {
        "text": "Quenching extinction was observed around 1 cm/s in concurrent flow.",
        "source": "ntrs:20140011099"
      },
      {
        "text": "Flame spread rate for 75 µm PMMA at 1 atm pressure and 21% oxygen concentration in the SDSU NCA is 0.216 cm/s with an R-squared correlation coefficient of 0.9995.",
        "source": "ntrs:20140004923"
      },
      {
        "text": "Flame spread rates for PMMA in the SDSU NCA agree well with true microgravity data except at very low relative velocities and for a few thick fuel data points.",
        "source": "ntrs:20140004923"
      },
      {
        "text": "Oxygen concentration plays a large role in the flame spread rate, with an optimal relative velocity that maximizes the flame spread rate at 21% oxygen concentration.",
        "source": "ntrs:20140004923"
      }
    ]
